{
  "name": "fragmentscleanfront",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --clearCache && jest",
    "test:smoke:reads": "maestro test .maestro/smoke-read-models.yaml",
    "test:smoke:offline": "maestro test .maestro/smoke-offline-cache.yaml",
    "native:release:check": "node scripts/check-native-release-config.mjs",
    "fingerprint:check": "node scripts/check-expo-fingerprint.mjs",
    "test:release:config": "node --test scripts/check-native-release-config.test.mjs scripts/inspect-ios-ipa.test.mjs scripts/mobile-ci-workflow.test.cjs scripts/release-public-config.test.cjs",
    "native:ipa:inspect": "node scripts/inspect-ios-ipa.mjs",
    "verify:ci": "npm run test:security && npm run security:check && npm run lint && npm run typecheck && npm run test:metro:watch && npm test -- --runInBand && npm run redux:map:check && npm run test:release:config && npm run native:release:check && npm run fingerprint:check",
    "redux:map": "node scripts/generate-redux-action-map.js",
    "redux:map:check": "node scripts/generate-redux-action-map.js --check",
    "build:dev": "eas build --profile development",
    "build:dev:fresh": "eas build --profile development --clear-cache",
    "build:prod": "eas build --profile production",
    "build:prod:fresh": "eas build --profile production --clear-cache",
    "test:metro:watch": "node --test scripts/metro-watch-compat.test.cjs",
    "security:check": "node scripts/check-mobile-security.cjs",
    "test:security": "node --test scripts/security-policy.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "jest": "~29.7.0",
    "jwt-decode": "^4.0.0",
    "metro-config": "0.83.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-clusterer": "^5.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "1.20.1",
    "react-native-mmkv-storage": "^12.0.0",
    "react-native-nitro-modules": "^0.30.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-text-recognition": "^1.0.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^30.0.5",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-config": "$metro-config",
    "metro-core": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "postcss": "8.5.28",
    "shell-quote": "1.12.0"
  },
  "private": true
}
